# Copiar a .env y ajustar valores
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/EntregaIA

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=entrega_ia
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

SESSION_NAME=entrega_ia_session

# Generador de prompts — https://console.groq.com/keys (formato: gsk_...)
GROQ_API_KEY=TU_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# Generador de video — https://studio.d-id.com/ (NO es la misma clave que Groq)
DID_API_KEY=TU_CLAVE_D_ID_AQUI
DID_PRESENTER_ID=v2_public_Amber@0zSz8kflCN
